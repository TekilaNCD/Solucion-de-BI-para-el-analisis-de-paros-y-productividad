	measure Pacas = SUM ( fact_produccion_turno[pacas_producidas] )
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 8c6308f1-01f2-401d-b9a1-776b6cdf4e60

	measure 'Pacas Meta' = SUM ( fact_produccion_turno[pacas_meta_turno] )
		formatString: #,0
