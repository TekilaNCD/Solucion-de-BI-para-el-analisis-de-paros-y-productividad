# =============================================================================
# Copie este archivo como .env y CAMBIE TODAS LAS CONTRASEÑAS.
# .env está en .gitignore: nunca se sube al repositorio.
# =============================================================================

# --- PostgreSQL (dueño de la base: ETL, simulador y receptor) ---------------
POSTGRES_DB=bi_envasado
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=Cambiar_Admin_2025
# Puerto publicado en el equipo anfitrión (DBeaver / Power BI). 5433 evita choque
# con un PostgreSQL instalado localmente.
POSTGRES_PORT=5433

# --- Roles de solo lectura para las capas de consumo ------------------------
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=Cambiar_Grafana_2025
POWERBI_DB_USER=powerbi_ro
POWERBI_DB_PASSWORD=Cambiar_PowerBI_2025

# --- Grafana -----------------------------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=Cambiar_GrafanaAdmin_2025
GRAFANA_PORT=3000

# --- ETL -----------------------------------------------------------------------
# Nombre del Excel dentro de data/raw/
EXCEL_ARCHIVO=SEGUIMIENTO TEMPERAS Y VINILOS Actividad.xlsm
# Sal para seudonimizar operarias y técnicos (si cambia, cambian los alias)
SEUDONIMO_SALT=cambie-esta-sal-por-una-frase-larga

# --- Simulador -----------------------------------------------------------------
# Cada tick = 1 hora de producción simulada por máquina
SIM_TICK_SEGUNDOS=10
SIM_BACKFILL_LECTURAS=180

TZ=America/Bogota
