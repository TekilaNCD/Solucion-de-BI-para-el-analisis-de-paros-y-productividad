          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-bi"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(paro_principal, 'Sin paro') AS \"Causa\",\n       ROUND(SUM(minutos_paro_no_programado)::numeric, 0) AS \"Minutos\"\nFROM ops.v_oee_hora\nWHERE $__timeFilter(ts)\n  AND maquina IN ($maquina)\n  AND turno IN ($turno)\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 8"
        }
