          "rawQuery": true,
          "rawSql": "SELECT maquina AS \"Máquina\", estado AS \"Estado\", oee_movil_12h AS \"OEE 12 h\",\n       oee_ultima_hora AS \"OEE última hora\", paro_principal AS \"Paro principal\",\n       referencia AS \"Referencia\", turno AS \"Turno\", segundos_desde_lectura AS \"Seg. desde lectura\",\n       modo_simulador AS \"Modo simulador\"\nFROM ops.v_estado_actual\nWHERE maquina IN ($maquina)\nORDER BY 1"
