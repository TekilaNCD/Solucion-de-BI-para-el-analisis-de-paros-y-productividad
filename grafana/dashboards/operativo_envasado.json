      },
      "description": "OEE = Disponibilidad × Rendimiento × Calidad sobre las últimas 12 lecturas de cada máquina. Umbral de alerta 60 %.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-bi"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT now() AS time, maquina AS metric, oee AS value\nFROM ops.v_oee_reciente\nWHERE maquina IN ($maquina)\nORDER BY 2"
